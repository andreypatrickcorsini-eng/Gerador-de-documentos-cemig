    },
    {
      "chave": "data_embargo",
      "rotulo": "Data do embargo",
      "tipo": "data",
      "grupo": "Área embargada",
      "obrigatorio": true
    },
    {
      "chave": "area_m2",
      "rotulo": "Área embargada (m²)",
      "tipo": "numero",
