        "Supressão de vegetação sem autorização",
        "Intervenção em Área de Preservação Permanente — APP",
        "Intervenção em Reserva Legal",
        "Obra ou atividade sem licença ambiental",
        "Descumprimento de condicionante",
        "Outro"
      ],
      "padrao": "Supressão de vegetação sem autorização"
    },
    {
      "chave": "objeto_embargado",
      "rotulo": "Objeto material do embargo",
      "tipo": "selecao",
      "grupo": "Área embargada",
