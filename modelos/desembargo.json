        "Área com vegetação suprimida",
        "Cultivo agrícola",
        "Pastagem",
        "Edificação",
        "Obra linear (faixa de servidão)",
        "Pátio de materiais",
        "Outro"
      ]
    },
    {
      "chave": "tipo_vegetacao",
      "rotulo": "Fitofisionomia afetada",
      "tipo": "selecao",
      "grupo": "Área embargada",
      "opcoes": [
        "Floresta Estacional Semidecidual",
        "Cerrado sentido restrito",
        "Campo rupestre",
        "Campo limpo / pastagem",
        "Vegetação exótica / cultivo",
        "Não se aplica"
      ]
    },
    {
      "chave": "prazo_recuperacao",
      "rotulo": "Prazo proposto para recuperação (meses)",
      "tipo": "numero",
      "grupo": "Compromissos",
      "padrao": "24"
    },
    {
      "chave": "data_inicio_recuperacao",
      "rotulo": "Início previsto da recuperação",
      "tipo": "data",
      "grupo": "Compromissos"
    },
    {
      "chave": "prad_numero",
      "rotulo": "Nº do PRAD / projeto de recuperação",
      "tipo": "texto",
      "grupo": "Compromissos",
      "placeholder": "Se já protocolado"
    },
    {
      "chave": "responsavel_nome",
      "rotulo": "Responsável técnico",
      "tipo": "texto",
      "grupo": "Responsabilidade técnica",
      "obrigatorio": true,
      "largo": true
    },
    {
      "chave": "responsavel_registro",
      "rotulo": "Registro CREA / CFT / CRBio",
      "tipo": "texto",
      "grupo": "Responsabilidade técnica",
      "obrigatorio": true
    },
    {
      "chave": "art_numero",
      "rotulo": "Nº da ART / RRT",
      "tipo": "texto",
      "grupo": "Responsabilidade técnica"
    },
    {
      "chave": "observacoes",
      "rotulo": "Observações / informações complementares",
      "tipo": "area",
      "grupo": "Complementos",
      "largo": true
    }
  ],
  "secoes": [
    {
      "titulo": "1. IDENTIFICAÇÃO DO REQUERENTE",
      "blocos": [
        {
          "tipo": "tabela_campos",
          "campos": [
            "interessado_nome",
            "interessado_documento",
            "interessado_telefone",
            "interessado_email",
            "procurador_nome",
            "procurador_documento"
          ]
        }
      ]
    },
    {
      "titulo": "2. IDENTIFICAÇÃO DA ÁREA EMBARGADA",
      "blocos": [
        {
          "tipo": "tabela_campos",
          "campos": [
            "empreendimento",
            "endereco",
            "municipio",
            "coordenadas",
            "auto_embargo",
            "data_embargo",
            "area_m2",
            "area_ha",
            "motivo_embargo",
            "objeto_embargado",
            "tipo_vegetacao",
            "protocolo"
          ]
        }
      ]
    },
    {
      "titulo": "3. DO REQUERIMENTO",
      "blocos": [
        {
          "tipo": "p",
          "texto": "Ao(À) {{orgao_destinatario}},"
        },
        {
          "tipo": "clausula",
          "titulo": "CLÁUSULA PRIMEIRA — DO OBJETO",
          "texto": "{{interessado_nome}}, inscrito(a) no CPF/CNPJ sob nº {{interessado_documento|cpfcnpj}}, na qualidade de responsável pelo empreendimento {{empreendimento}}, localizado no município de {{municipio}}/{{uf}}, requer o DESEMBARGO da área de {{area_m2|numero}} m² ({{area_ha|numero}} ha), objeto do Auto de Embargo nº {{auto_embargo}}, lavrado em {{data_embargo|data}}, em razão de {{motivo_embargo|minusculo}}."
        },
        {
          "tipo": "clausula",
          "titulo": "CLÁUSULA SEGUNDA — DOS FATOS E FUNDAMENTOS",
          "texto": "A área embargada encontra-se identificada no item 2 deste requerimento e delimitada na planta e no memorial descritivo anexos. O requerente reconhece a ocorrência descrita no auto de embargo e informa que as medidas de controle e recuperação ambiental estão descritas no Plano de Recuperação de Áreas Degradadas — PRAD{{?prad_numero}} nº {{prad_numero}}{{/prad_numero}} ou serão apresentadas no prazo assinalado por esse órgão, atendendo ao disposto na Lei nº 12.651/2012 e na legislação ambiental do Estado de Minas Gerais."
        },
        {
          "tipo": "clausula",
          "titulo": "CLÁUSULA TERCEIRA — DAS MEDIDAS DE CONTROLE E RECUPERAÇÃO",
          "texto": "O requerente compromete-se a:"
        },
        {
          "tipo": "lista",
          "itens": [
            "manter a área embargada isolada e sinalizada até a decisão definitiva sobre o desembargo;",
            "executar o PRAD no prazo de {{prazo_recuperacao|numero}} meses{{?data_inicio_recuperacao}}, com início previsto em {{data_inicio_recuperacao|data}}{{/data_inicio_recuperacao}}, sob responsabilidade técnica de {{responsavel_nome}} ({{responsavel_registro}});",
            "não suprimir vegetação nativa remanescente nem ampliar a intervenção na área objeto do embargo;",
            "apresentar relatórios técnicos de acompanhamento semestrais, com registro fotográfico e indicadores de recuperação;",
            "adotar as medidas de prevenção a incêndios e de proteção da fauna na área em recuperação."
          ]
        },
        {
          "tipo": "clausula",
          "titulo": "CLÁUSULA QUARTA — DA DOCUMENTAÇÃO INSTRUTÓRIA",
          "texto": "Acompanham este requerimento os documentos comprobatórios das medidas adotadas e da titularidade da área, conforme relação abaixo."
        },
        {
          "tipo": "clausula",
          "titulo": "CLÁUSULA QUINTA — DO PEDIDO",
          "texto": "Diante do exposto, requer-se o recebimento e o processamento do presente requerimento, com o consequente desembargo da área identificada, bem como a suspensão das sanções administrativas acessórias enquanto perdurar a análise, nos termos da legislação aplicável."
        },
        {
          "tipo": "condicional",
          "campo": "observacoes",
          "titulo": "3.1 INFORMAÇÕES COMPLEMENTARES",
          "blocos": [
            { "tipo": "lista_campo", "campo": "observacoes" }
          ]
        }
      ]
    },
    {
      "titulo": "4. RESPONSABILIDADE TÉCNICA",
      "blocos": [
        {
          "tipo": "tabela_campos",
          "campos": ["responsavel_nome", "responsavel_registro", "art_numero", "prad_numero"]
        }
      ]
    },
    {
      "titulo": "5. DOCUMENTOS ANEXOS",
      "blocos": [
        {
          "tipo": "lista",
          "itens": [
            "cópia do Auto de Embargo nº {{auto_embargo}} e da respectiva notificação;",
            "Plano de Recuperação de Áreas Degradadas — PRAD e respectiva ART/RRT{{?art_numero}} nº {{art_numero}}{{/art_numero}};",
            "planta e memorial descritivo da área embargada, com coordenadas georreferenciadas;",
            "comprovante de titularidade, posse ou anuência do proprietário da área;",
            "documento de identificação do requerente e procuração, quando for o caso;",
            "relatório fotográfico da área na data do presente requerimento."
          ]
        }
      ]
    }
  ],
  "encerramento": "Nestes termos, o requerente pede deferimento.",
  "fecho_local": "{{municipio}}/{{uf}}, {{data_documento|data_extenso}}.",
  "assinaturas": [
    { "papel": "Requerente", "nome": "{{interessado_nome}}", "linha2": "CPF/CNPJ: {{interessado_documento|cpfcnpj}}" },
    { "papel": "Responsável Técnico", "nome": "{{responsavel_nome}}", "linha2": "{{responsavel_registro}}" }
  ]
}
