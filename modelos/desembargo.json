{
  "id": "desembargo",
  "nome": "Desembargo",
  "icone": "🌱",
  "descricao": "Requerimento de desembargo de área objeto de auto de embargo ambiental, com compromissos de recuperação.",
  "titulo_documento": "REQUERIMENTO DE DESEMBARGO DE ÁREA",
  "subtitulo": "Instruído nos termos da Lei nº 12.651/2012 e da legislação ambiental do Estado de Minas Gerais.",
  "campos": [
