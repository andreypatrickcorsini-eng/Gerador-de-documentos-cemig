      "obrigatorio": true
    },
    {
      "chave": "uf",
      "rotulo": "UF",
      "tipo": "selecao",
      "grupo": "Área embargada",
      "obrigatorio": true,
      "opcoes": ["MG"],
      "padrao": "MG"
    },
    {
      "chave": "endereco",
      "rotulo": "Localização / acesso",
      "tipo": "texto",
      "grupo": "Área embargada",
      "largo": true
    },
    {
      "chave": "coordenadas",
      "rotulo": "Coordenadas geográficas",
      "tipo": "texto",
      "grupo": "Área embargada",
      "placeholder": "-21,5555 / -45,4343 (datum SIRGAS 2000)"
    },
    {
      "chave": "auto_embargo",
      "rotulo": "Nº do auto de embargo / fiscalização",
      "tipo": "texto",
      "grupo": "Área embargada",
