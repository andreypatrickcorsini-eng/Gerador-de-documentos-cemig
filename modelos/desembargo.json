      "origem": ["area_m2"],
      "dica": "Convertida automaticamente a partir dos metros quadrados."
    },
    {
      "chave": "motivo_embargo",
      "rotulo": "Motivo do embargo",
      "tipo": "selecao",
      "grupo": "Área embargada",
